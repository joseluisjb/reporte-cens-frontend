# URL base del backend Django. En desarrollo se usa el proxy de Vite (/api → localhost:8000).
VITE_API_URL=/api

# true = usa datos simulados (MSW) mientras no existan los endpoints reales.
VITE_USE_MOCKS=true

# Minutos de inactividad antes de cerrar la sesión (RF26). Debe coincidir con el backend.
# Admite decimales para probar rápido (ej. 0.5 = 30 segundos).
VITE_IDLE_MINUTES=10

# Solo desarrollo: muestra el atajo "Cambiar de perfil" para alternar Analista/Administrador.
# Nunca true en producción.
VITE_DEMO_MODE=false

# Solo desarrollo: backend al que apunta el proxy de Vite para /api (sin prefijo VITE_: no llega al
# navegador). Por defecto http://localhost:8000. Para probar contra Render, descomenta la segunda
# línea y pon VITE_USE_MOCKS=false (ver docs/DESPLIEGUE.md).
# API_PROXY_TARGET=http://localhost:8000
# API_PROXY_TARGET=https://reporte-cens-backend.onrender.com
